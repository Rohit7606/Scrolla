# Copy to keystore.properties (gitignored) and fill in.
#
# The real file and the .jks it points at are the app's permanent identity:
# Android enforces signature match on update, so losing them means every
# existing user must uninstall — deleting their scroll history — before they
# can install another build. Back both up off this machine.
storeFile=scrolla-release.jks
storePassword=
keyAlias=scrolla
keyPassword=
