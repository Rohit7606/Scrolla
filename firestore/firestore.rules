rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Which top-level fields this write actually changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 1. Users can only read/write their own profile and their own group membership list
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // 2. Daily totals: anyone authenticated can read, but you can only write your own
    // The docId must start with your UID (e.g., "uid_2026-08-16")
    match /groups/{groupId}/dailyTotals/{docId} {
      allow read: if signedIn();
      allow write: if signedIn()
                    && docId.matches(request.auth.uid + '_.*')
                    && request.resource.data.userId == request.auth.uid;
    }

    // 3. Group metadata
    match /groups/{groupId} {

      // A join needs to fetch a group by its code before the user is a member,
      // so a single-document get stays open to any signed-in user. Listing the
      // collection does not: `allow read` covers list queries too, which let any
      // signed-in user enumerate every group in the app and read its join code.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn();

      // `create` alone does not grant `update`, which left two things broken:
      // joinGroup()'s arrayUnion on `members` was denied, and the group record
      // fields could never be written by anyone. Both are allowed now, each
      // narrowed to exactly the fields and shape it needs.
      allow update: if isSelfJoin() || isRecordImprovement();
    }

    // Adding yourself to a group, changing nothing else. Existing members must
    // all survive, so a member cannot quietly remove anyone else.
    function isSelfJoin() {
      return signedIn()
              && changedKeys().hasOnly(['members'])
              && request.auth.uid in request.resource.data.members
              && request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.size() <= resource.data.members.size() + 1;
    }

    // Setting the group's all-time best day. Members only, record fields only,
    // and lowest-wins: a record can only ever be improved, never inflated.
    function isRecordImprovement() {
      return signedIn()
              && request.auth.uid in resource.data.members
              && changedKeys().hasOnly(['recordKm', 'recordHolder', 'recordDate'])
              && (
                   !('recordKm' in resource.data)
                   || request.resource.data.recordKm <= resource.data.recordKm
                 );
    }
  }
}
