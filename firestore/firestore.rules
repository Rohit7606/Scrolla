rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Which top-level fields this write actually changes.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 1. Users can only read/write their own profile and their own group membership list
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // 1b. The user's own backup of their daily distances.
    //
    // Why this exists separately from /groups/{g}/dailyTotals: that collection
    // is leaderboard data. It is written once per group the user belongs to, so
    // a user in no group syncs nothing at all, and it is stored under the group
    // rather than under the person. Nothing ever read it back, so an uninstall
    // lost everything. This collection is the personal copy — one document per
    // day, owned by the user, and the thing that makes signing in mean "your
    // history is yours" rather than only "you can be on a leaderboard".
    //
    // Note this needs its own match block: rule 1's `allow read, write` on
    // /users/{userId} does NOT cascade to subcollections in Firestore. Without
    // this block every write here is denied, which is exactly what happens today.
    //
    // Strictly private — no `allow read` for other signed-in users, unlike the
    // group copy. Nobody needs to see anyone else's full history.
    match /users/{userId}/dailyTotals/{day} {
      allow read, delete: if isOwner(userId);

      allow create, update: if isOwner(userId)
                    && day.matches('\\d{4}-\\d{2}-\\d{2}')
                    && request.resource.data.keys().hasOnly(['date', 'totalKm', 'updatedAt'])
                    && request.resource.data.date == day
                    && request.resource.data.totalKm is number
                    && request.resource.data.totalKm >= 0;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 2. Daily totals: anyone authenticated can read, but you can only write your own
    // The docId must start with your UID (e.g., "uid_2026-08-16")
    match /groups/{groupId}/dailyTotals/{docId} {
      allow read: if signedIn();

      // `allow write` covered create, update AND delete — but on a delete
      // `request.resource` is null, so the userId check could never pass and
      // deleting your own totals was impossible. That made account deletion
      // unimplementable, which is why this is split.
      allow create, update: if signedIn()
                    && docId.matches(request.auth.uid + '_.*')
                    && request.resource.data.userId == request.auth.uid;

      // Deleting is gated on the doc id alone, since there is no incoming
      // document to inspect. The id is prefixed with the owner's uid.
      allow delete: if signedIn() && docId.matches(request.auth.uid + '_.*');
    }

    // 3. Group metadata
    match /groups/{groupId} {

      // A join needs to fetch a group by its code before the user is a member,
      // so a single-document get stays open to any signed-in user. Listing the
      // collection does not: `allow read` covers list queries too, which let any
      // signed-in user enumerate every group in the app and read its join code.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn();

      // `create` alone does not grant `update`, which left two things broken:
      // joinGroup()'s arrayUnion on `members` was denied, and the group record
      // fields could never be written by anyone. Both are allowed now, each
      // narrowed to exactly the fields and shape it needs.
      allow update: if isSelfJoin() || isRecordImprovement() || isSelfLeave() || isGroupRename();
    }

    // Adding yourself to a group, changing nothing else. Existing members must
    // all survive, so a member cannot quietly remove anyone else.
    function isSelfJoin() {
      return signedIn()
              && changedKeys().hasOnly(['members'])
              && request.auth.uid in request.resource.data.members
              && request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.size() <= resource.data.members.size() + 1;
    }

    // Removing yourself from a group, and nothing else. Needed for account
    // deletion: leaving data behind in someone else's group is not deletion.
    //
    // The three conditions together permit exactly one removal, of yourself:
    // the new list must be a subset of the old (so nobody can be added), must
    // be exactly one shorter, and must not contain the caller. Without the
    // subset check a member could remove someone else and add an impostor,
    // which keeps the size arithmetic intact.
    function isSelfLeave() {
      return signedIn()
              && changedKeys().hasOnly(['members'])
              && request.auth.uid in resource.data.members
              && !(request.auth.uid in request.resource.data.members)
              && request.resource.data.members.hasOnly(resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() - 1;
    }

    // Renaming a group, and nothing else.
    //
    // Any member, not just the creator. `createdBy` exists and creator-only was
    // the obvious first choice, but a creator can now leave the group
    // (isSelfLeave), which under creator-only would strand the name forever with
    // nobody able to correct even a typo. The blast radius is a shared label
    // among people who already chose to be in a group together, and it is
    // trivially reversible.
    //
    // The length bound is enforced here as well as in the client because a rule
    // is the only place a hostile client cannot skip. An empty name would render
    // as a blank row that still has to be tapped to identify.
    function isGroupRename() {
      return signedIn()
              && request.auth.uid in resource.data.members
              && changedKeys().hasOnly(['groupName'])
              && request.resource.data.groupName is string
              && request.resource.data.groupName.size() > 0
              && request.resource.data.groupName.size() <= 40;
    }

    // Setting the group's all-time best day. Members only, record fields only,
    // and lowest-wins: a record can only ever be improved, never inflated.
    function isRecordImprovement() {
      return signedIn()
              && request.auth.uid in resource.data.members
              && changedKeys().hasOnly(['recordKm', 'recordHolder', 'recordDate'])
              && (
                   !('recordKm' in resource.data)
                   || request.resource.data.recordKm <= resource.data.recordKm
                 );
    }
  }
}
