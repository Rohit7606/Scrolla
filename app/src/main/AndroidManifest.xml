<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Drives the app's own haptics. A normal permission, so no runtime
         prompt. Needed because Scrolla uses the vibrator channel rather than
         View.performHapticFeedback(), which is gated on the system's
         touch-feedback setting - see ui/components/Haptics.kt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- P2.15: turns the battery-unrestricted step into a single system dialog
         instead of a multi-level navigation the user has to find. Play-restricted,
         which does not apply here — Scrolla is sideloaded by decision (P0.5a). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Needed to turn the package ids the accessibility service records into app
        names on the Insights breakdown. Since Android 11 package visibility is
        filtered by default, so getApplicationInfo() throws for every third-party
        app and the list degrades to raw package ids.

        This is a Play-restricted permission. That is settled rather than
        pending: PREMIUM_CHECKLIST P0.5a records the decision (2026-08-26) that
        Scrolla stays a sideloaded APK and is not going on the Play Store, so
        this permission is fine and stays. The reason is not convenience — Play
        restricts AccessibilityService to accessibility purposes, and scroll
        distance is not one, and no other API provides it. If that decision is
        ever revisited, swap this for a <queries> element and accept a shorter
        app list.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:name=".auth.ScrollaApplication">

        <service
            android:name=".service.ScrollAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks scroll distance via accessibility events for personal usage statistics" />
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Scrolla.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Serves the CSV export as a content:// URI so the share sheet
            attaches a real file. Sharing it through EXTRA_TEXT instead put the
            whole CSV in the message body, which chat apps paste as text — that
            is a long message, not an export.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".device.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- P2.12: fired only by our own AlarmManager, so it is not exported. -->
        <receiver
            android:name=".device.TrackingHealthReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>
</manifest>