<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's card. Mirrors ScrollaCard: a filled surface one step above the
    ground, with a hairline border and the same 20dp corner. Depth comes from
    the surface step plus the hairline, not from a shadow — a widget sits on the
    user's wallpaper, where a drop shadow reads as a sticker.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_hairline" />
</shape>
