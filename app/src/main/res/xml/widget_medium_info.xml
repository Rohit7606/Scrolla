<?xml version="1.0" encoding="utf-8"?>
<!--
    Medium widget, 4x2 (SPRINT_LOG S3.9). Same update model as the small one:
    driven by ScrollaWidgets' alarm and by a push after each batch flush, never
    by updatePeriodMillis — see widget_today_info.xml for why.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_medium"
    android:previewLayout="@layout/widget_medium"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_medium_description" />
