<?xml version="1.0" encoding="utf-8"?>
<!--
    Large widget, 4x4 (SPRINT_LOG S3.9). Same update model as the other sizes:
    ScrollaWidgets' alarm plus a push after each batch flush, never
    updatePeriodMillis — see widget_today_info.xml.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_large"
    android:previewLayout="@layout/widget_large"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_large_description" />
