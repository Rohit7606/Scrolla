<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main application theme -->
    <style name="Theme.MyApplication" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Splash Screen theme for Android 12+ -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#ED6A5A</item> <!-- Accent500 -->
        <!-- Icon to display in the center -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/scrolla_logo_small</item>
        <!-- Theme to switch to after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <!-- Fallback for pre-API 31 devices. The manifest references Theme.Scrolla.Splash
         but values-v31/ has the real SplashScreen API definition. On older devices
         the compat SplashScreen library handles the splash, so this just needs to
         exist and hand off to the main theme. -->
    <style name="Theme.Scrolla.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#ED6A5A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/scrolla_logo_small</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>