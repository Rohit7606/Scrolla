<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main application theme.

         Was Theme.AppCompat.Light.NoActionBar — a hardcoded light theme, so a
         device in dark mode flashed a near-white window before Compose drew
         its first frame, and showed the same near-white in the overscroll
         stretch. DayNight lets values-night/ resolve, and windowBackground is
         pinned to the ground step of the surface ladder in both. -->
    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/scrolla_ground</item>
    </style>

    <!-- Splash Screen theme for Android 12+ -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#ED6A5A</item> <!-- Accent500 -->
        <!-- Icon to display in the center -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/scrolla_logo_small</item>
        <!-- Theme to switch to after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <!-- Fallback for pre-API 31 devices. The manifest references Theme.Scrolla.Splash
         but values-v31/ has the real SplashScreen API definition. On older devices
         the compat SplashScreen library handles the splash, so this just needs to
         exist and hand off to the main theme. -->
    <style name="Theme.Scrolla.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#ED6A5A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/scrolla_logo_small</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>