<?xml version="1.0" encoding="utf-8"?>
<!--
    Small widget — today's distance (BUILD_PLAN 3.1, SPRINT_LOG S2.6).
    Shows getTodayTotalKm() and the nearest landmark; tapping opens Home.

    **Fills the cell rather than hugging its content.** The first version sized
    everything to wrap_content and centred the block, which looked correct on a
    square 2x2 and left a large gap on a real phone — MIUI's 2x2 cell is taller
    than it is wide, and the neighbouring widgets on that home screen (Screen
    time, Security) fill theirs completely. A widget that leaves a third of its
    card empty reads as unfinished next to ones that do not.

    So the label is pinned to the top, the landmark to the bottom, and the
    figure takes the weighted space between them. That holds at any cell aspect
    a launcher hands us instead of assuming one.

    The type mirrors HomeScreen — Instrument Serif for the figure, Space Grotesk
    for the micro label — so the widget and the app look like one product.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_today_label"
        android:textColor="@color/widget_text_mid"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:fontFamily="@font/space_grotesk_medium"
        android:maxLines="1" />

    <!-- The figure owns the space between the two labels. Centred inside its
         own weighted band, so it stays optically central whatever the cell
         height turns out to be. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_value"
            android:textColor="@color/widget_accent"
            android:textSize="46sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/instrument_serif_regular"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_unit"
            android:textColor="@color/widget_text_mid"
            android:textSize="15sp"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="5dp"
            android:layout_gravity="bottom"
            android:fontFamily="@font/inter_regular"
            android:maxLines="1" />
    </LinearLayout>

    <!-- The landmark. Two lines because "≈ Empire State Building height" does
         not fit on one at this width, and truncating it mid-phrase loses the
         part that makes the number mean anything. -->
    <TextView
        android:id="@+id/widget_landmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_placeholder_landmark"
        android:textColor="@color/widget_text_mid"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="@font/inter_regular"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
